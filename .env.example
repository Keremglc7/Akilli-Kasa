# ─────────────────────────────────────────────────────────────────────
# Akilli Kasa - ortam degiskenleri
#
# Kurulum:  cp .env.example .env      (Windows: copy .env.example .env)
# Ardindan asagidaki anahtari kendi Roboflow anahtarinizla degistirin.
#
# .env dosyasi .gitignore icindedir; asla commit etmeyin.
# ─────────────────────────────────────────────────────────────────────

# Roboflow hosted inference API anahtari
# app.roboflow.com -> Settings -> API Keys
ROBOFLOW_API_KEY=buraya_kendi_anahtarinizi_yazin

# Model kimligi (Roboflow proje adi / surum) ve API adresi
ROBOFLOW_MODEL_ID=akilli_kasa/1
ROBOFLOW_API_URL=https://detect.roboflow.com

# Web sunucusu baglantisi.
# 127.0.0.1 = yalnizca bu makine. Kamera akisinda kimlik dogrulamasi
# olmadigi icin, bilerek istemedikce 0.0.0.0 yapmayin.
KASA_HOST=127.0.0.1
KASA_PORT=5000
